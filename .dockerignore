# Exclude from Docker build context. Keep image small + secret-free.

# Git / version control
.git/
.gitignore
.gitattributes
.github/ISSUE_TEMPLATE/
.github/PULL_REQUEST_TEMPLATE.md
.github/workflows/

# Documentation (kept in repo, not needed in image)
docs/
*.md
!broker/README.md
README.md
CHANGELOG.md
RELEASE-NOTES-*.md
V4.1-COMPLETE.md
VERIFY.md
CONTRIBUTING.md
LICENSE

# Tests (run in CI, not in image)
broker-test/
sdk/python/tests/
sdk/python/.pytest_cache/
sdk/python/__pycache__/
sdk/python/secret_broker/__pycache__/
sdk/python/.mypy_cache/
sdk/python/.tox/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
.npm/
.pnpm-store/

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Go
*.exe
*.test
*.out

# TypeScript
*.tsbuildinfo

# Secrets (NEVER include in image — runtime mount only)
secrets/
secrets-*.yaml
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
audit/

# Broker runtime scratch
tmp/
*.log
*.pid
.cache/

# Test fixtures
test-data/
fixtures/
mocks/
