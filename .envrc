# .envrc
# direnv 自动加载（首次进入会提示 direnv allow）
# https://direnv.net/

# 路径布局
export PROJECT_ROOT="$PWD"
export PATH="$PWD/scripts:$PATH"

# 解密 SOPS 文件到环境变量
# 用 --output-type dotenv 输出 KEY=VALUE 格式
if [ -f "$PROJECT_ROOT/secrets/common.yaml" ]; then
  eval "$(sops --decrypt --output-type dotenv "$PROJECT_ROOT/secrets/common.yaml" 2>/dev/null || true)"
fi

if [ -f "$PROJECT_ROOT/secrets/dev.yaml" ]; then
  eval "$(sops --decrypt --output-type dotenv "$PROJECT_ROOT/secrets/dev.yaml" 2>/dev/null || true)"
fi

# 项目专属变量
export NODE_ENV=development
export LOG_LEVEL=debug

# 加载 mise 管理的运行时（可选）
# eval "$(mise activate bash)"  # PowerShell 用户用 direnv 自带集成
