# .envrc
# direnv auto-load. Run `direnv allow` once after editing.
# On Windows, add this to $PROFILE to enable the PowerShell hook:
#   Invoke-Expression "$(direnv export powershell)"
# The setup-direnv task does that for you.

# 1. Decrypt SOPS secrets to .env (overwrites existing .env)
#    Skipped if SOPS is not installed or no age key is present.
if command -v sops >/dev/null 2>&1; then
  if [ -f "$PWD/secrets/common.env" ]; then
    sops --decrypt --output-type dotenv "$PWD/secrets/common.env" > "$PWD/.env" 2>/dev/null && export_dotenv "$PWD/.env"
  fi
fi

# 2. Project-scoped variables
export NODE_ENV=development
export LOG_LEVEL=debug
export PROJECT_ROOT="$PWD"

# 3. PATH additions for local tooling
path_add "$PWD/scripts"
path_add "$PWD/node_modules/.bin"

# 4. direnv-specific: fail fast on missing tools
#    (uncomment to enforce)
# if ! command -v node >/dev/null; then
#   log_error "node not found. Run: scoop install nodejs"
# fi
