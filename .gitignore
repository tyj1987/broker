# .gitignore
# ============================
# 绝对不能入库的（红线）/ Hard rules — must NEVER enter git
# ============================

# age / SOPS 私钥 / age / SOPS private keys
*.key
key-*.txt
*.age.key
sops/age/

# 临时解密产物 / Decrypted scratch files
*.dec.yaml
*.dec.yml
*.dec.env
.env.decrypted
.env.local
.env.*.local
.env

# SSH / TLS 私钥 / SSH / TLS private keys
*.pem
id_rsa
id_ed25519
*.p12
*.pfx

# IDE / 编辑器 / IDE / editor
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Node / Python / Go 通用 / Generic
node_modules/
__pycache__/
*.pyc
.venv/
venv/
target/
dist/
build/
*.log
coverage/
.nyc_output/

# 任务临时文件 / Task scratch
tmp/
.tmp/

# 备份钥匙归档（轮转时的临时归档）/ Key rotation archives
.config/sops/age/archive-*/

# ============================
# 加密文件可以入（显式放行）/ Encrypted files OK
# ============================
# 加密后的 secrets/*.env 格式：
#   DATABASE_URL: ENC[AES256_GCM,...]
#   sops:
#     age: [...]
# 这是 SOPS 密文，入库安全。Encrypted secrets ARE safe to commit.

# ============================
# Secret Broker 特定 / Secret Broker specific
# ============================
# PKI 证书和私钥（ca.crt 例外，需要分发给客户端）
pki/**/*.key
pki/**/*.crt
pki/**/*.csr
pki/**/*.ext
pki/**/crl.pem
pki/**/index.txt*
pki/**/serial*
pki/**/openssl.cnf
# 但保留 ca.crt（要分发）
!pki/ca/ca.crt
!pki/ca/.gitkeep

# Audit 日志
audit/*.jsonl
audit/*.log

# 客户端配置（含 cert 路径）
.broker/

