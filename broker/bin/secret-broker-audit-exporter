#!/opt/secret-broker/runtime/node/bin/node

import {
  createAuditAnchorExporterRuntime,
  readAuditAnchorExporterConfig,
  runAuditAnchorExporterService,
} from '../lib/audit-anchor-exporter-runtime.js';
import { loadAuditChainProofSync, loadAuditChainStateSync } from '../lib/audit-hash-chain.js';
import { createLocalAuditAnchorSignerClient } from '../lib/local-audit-anchor-signer-client.js';
import { createLocalAuditAnchorStoreClient } from '../lib/local-audit-anchor-store-client.js';

const args = process.argv.slice(2);
if (args.length !== 2 || args[0] !== '--config') {
  console.error(JSON.stringify({ status: 'failed', code: 'anchor_exporter_argument_invalid' }));
  process.exitCode = 64;
} else {
  const shutdown = new AbortController();
  for (const signal of ['SIGINT', 'SIGTERM']) {
    process.once(signal, () => shutdown.abort());
  }
  try {
    const config = await readAuditAnchorExporterConfig(args[1]);
    const signer = createLocalAuditAnchorSignerClient({
      algorithm: config.algorithm,
      keyId: config.activeKeyId,
      timeoutMs: config.signerTimeoutMs,
    });
    const store = createLocalAuditAnchorStoreClient({
      streamId: config.streamId,
      timeoutMs: config.storeTimeoutMs,
    });
    const runtime = createAuditAnchorExporterRuntime({
      config,
      signer,
      store,
      loadChainState: async () => loadAuditChainStateSync(config.auditDirectory, { chainOnly: true }),
      loadChainProof: async (eventCount) => loadAuditChainProofSync(config.auditDirectory, eventCount),
    });
    await runAuditAnchorExporterService({
      runtime,
      intervalMs: config.intervalMs,
      exportDeadlineMs: config.exportDeadlineMs,
      signal: shutdown.signal,
    });
  } catch (error) {
    console.error(JSON.stringify({
      status: 'failed',
      code: typeof error?.code === 'string' ? error.code : 'anchor_exporter_failed',
    }));
    process.exitCode = 1;
  }
}
