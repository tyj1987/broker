{
  "name": "secret-broker",
  "version": "3.4.0",
  "description": "mTLS Secret Broker with SOPS-backed credentials, proxy-mode for AI clients",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:lib": "node ../broker-test/test-lib-phase-b.js",
    "test:ip": "node ../broker-test/test-ip-allowlist.js",
    "test:routes": "node ../broker-test/test-routes-phase-b2.js && node ../broker-test/test-routes-auth-me.js && node ../broker-test/test-routes-b4.js",
    "test:modular": "npm run test:lib && npm run test:ip && npm run test:routes"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "license": "MIT"
}
