{
  "name": "secret-broker",
  "version": "3.8.0",
  "description": "mTLS Secret Broker with SOPS-backed credentials, proxy-mode for AI clients",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "wire": "node ../scripts/broker/apply-phase-af-full-wire.mjs",
    "test:lib": "node ../broker-test/test-lib-phase-b.js",
    "test:ip": "node ../broker-test/test-ip-allowlist.js",
    "test:routes": "node ../broker-test/test-routes-phase-b2.js && node ../broker-test/test-routes-auth-me.js && node ../broker-test/test-routes-b4.js",
    "test:obs": "node ../broker-test/test-phase-c-obs.js",
    "test:trace": "node ../broker-test/test-phase-d-trace-audit.js",
    "test:ops": "node ../broker-test/test-phase-e-ops.js",
    "test:backup": "node ../broker-test/test-phase-f-backup-probes.js",
    "test:redact": "node ../broker-test/test-redact.js",
    "test:mfa": "node ../broker-test/test-mfa-policy.js",
    "test:sms": "node ../broker-test/test-sms-provider.js",
    "test:apikeys-v4": "node ../broker-test/test-api-keys-rate.js",
    "test:v4": "npm run test:redact && npm run test:mfa && npm run test:sms && npm run test:apikeys-v4",
    "test:workload": "node ../broker-test/test-workload-identity.js",
    "test:v4-modules": "node ../broker-test/test-v4-modules.js",
    "test:modular": "npm run test:lib && npm run test:ip && npm run test:routes && npm run test:obs && npm run test:trace && npm run test:ops && npm run test:backup && npm run test:v4"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "license": "MIT"
}
