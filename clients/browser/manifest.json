{
  "manifest_version": 3,
  "name": "Secret Broker Fill",
  "version": "0.1.0",
  "description": "User-initiated one-time code fill for approved sites.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "scripting"],
  "host_permissions": [
    "https://account.aliyun.com/*",
    "https://cloud.tencent.com/login/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Fill approved code", "default_popup": "popup.html" }
}
