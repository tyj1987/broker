#!/usr/bin/env bash
set -euo pipefail

[[ "$#" -eq 1 ]] || { echo 'expected exactly one release SHA' >&2; exit 64; }
readonly RELEASE_SHA="${1:-}"
readonly ROOT=/opt/secret-broker
readonly RELEASES="$ROOT/releases"
readonly CURRENT="$ROOT/broker"
readonly SOURCE_ARCHIVE="/tmp/broker-$RELEASE_SHA.tgz"
readonly SOURCE_CHECKSUM="$SOURCE_ARCHIVE.sha256"
readonly SOURCE_ATTESTATION="/tmp/broker-$RELEASE_SHA.attestation.jsonl"
readonly NODE_RUNTIME=/opt/secret-broker/runtime/node/bin/node
readonly GH_CLI=/usr/bin/gh
readonly ATTESTATION_TRUST_ROOT=/etc/secret-broker/github-attestation-trusted-root.jsonl
readonly AUDIT_DIR=/var/lib/secret-broker/audit
readonly HEALTH_SOCKET=/run/secret-broker-health/health.sock

[[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid release SHA' >&2; exit 64; }
[[ -x "$NODE_RUNTIME" ]] || { echo 'pinned Node runtime is unavailable' >&2; exit 65; }
[[ -x "$GH_CLI" && ! -L "$GH_CLI" ]] || { echo 'GitHub attestation verifier is unavailable' >&2; exit 65; }
find "$GH_CLI" -maxdepth 0 -type f -user root ! -perm /022 -print -quit | grep -Fxq "$GH_CLI" || {
  echo 'GitHub attestation verifier is not root-owned and immutable' >&2
  exit 65
}
[[ -f "$ATTESTATION_TRUST_ROOT" && ! -L "$ATTESTATION_TRUST_ROOT" ]] || {
  echo 'GitHub attestation trust root is unavailable' >&2
  exit 65
}
find "$ATTESTATION_TRUST_ROOT" -maxdepth 0 -type f -user root ! -perm /022 -print -quit | grep -Fxq "$ATTESTATION_TRUST_ROOT" || {
  echo 'GitHub attestation trust root is not root-owned and immutable' >&2
  exit 65
}
[[ "$($NODE_RUNTIME --version)" =~ ^v24\. ]] || { echo 'pinned Node runtime is outside the supported major version' >&2; exit 65; }
[[ -L "$CURRENT" ]] || { echo 'current release is not a managed symlink' >&2; exit 65; }
[[ "$(systemctl show secret-broker.service -p User --value)" == broker ]] || {
  echo 'broker service is not running as the dedicated user' >&2
  exit 65
}
[[ "$(systemctl show secret-broker.service -p Group --value)" == broker ]] || {
  echo 'broker service is not running as the dedicated group' >&2
  exit 65
}
systemctl is-active --quiet secret-broker-policy.service || {
  echo 'policy core is not active' >&2
  exit 65
}
while read -r audit_service expected_user expected_group; do
  systemctl is-active --quiet "$audit_service" || {
    echo "required audit service is not active: $audit_service" >&2
    exit 65
  }
  audit_user="$(systemctl show "$audit_service" -p User --value)"
  audit_group="$(systemctl show "$audit_service" -p Group --value)"
  [[ "$audit_user" == "$expected_user" && "$audit_group" == "$expected_group" ]] || {
    echo "audit service identity does not match the pinned contract: $audit_service" >&2
    exit 65
  }
done <<'AUDIT_SERVICES'
secret-broker-audit-signer.service broker-audit-signer broker-audit-signer
secret-broker-audit-exporter.service broker-audit-exporter broker-audit-exporter
secret-broker-audit-store.service broker-audit-store broker-audit-store
secret-broker-audit-recovery.service broker-audit-recovery broker-audit-recovery
AUDIT_SERVICES

NGINX_EFFECTIVE="$(nginx -T 2>&1)" || {
  echo 'nginx configuration is invalid' >&2
  exit 65
}
readonly NGINX_EFFECTIVE
grep -Eq '^[[:space:]]*proxy_ssl_verify[[:space:]]+on;' <<<"$NGINX_EFFECTIVE" || {
  echo 'nginx upstream certificate verification is not enabled' >&2
  exit 65
}
if grep -Eq '^[[:space:]]*proxy_ssl_verify[[:space:]]+off;' <<<"$NGINX_EFFECTIVE"; then
  echo 'nginx contains disabled upstream certificate verification' >&2
  exit 65
fi

for forbidden_key_root in \
  /etc/secret-broker/pki/ca \
  /etc/secret-broker/pki/clients \
  /opt/secret-broker/pki; do
  if [[ -d "$forbidden_key_root" ]] && \
    find "$forbidden_key_root" -type f -name '*.key' -print -quit | grep -q .; then
    echo "forbidden CA or client private key exists under $forbidden_key_root" >&2
    exit 65
  fi
done
[[ -f "$SOURCE_ARCHIVE" && ! -L "$SOURCE_ARCHIVE" ]] || { echo 'release archive missing or unsafe' >&2; exit 66; }
[[ -f "$SOURCE_CHECKSUM" && ! -L "$SOURCE_CHECKSUM" ]] || { echo 'release checksum missing or unsafe' >&2; exit 66; }
[[ -f "$SOURCE_ATTESTATION" && ! -L "$SOURCE_ATTESTATION" ]] || { echo 'release attestation missing or unsafe' >&2; exit 66; }

if [[ -n "${SUDO_UID:-}" ]]; then
  [[ "$(stat -c %u "$SOURCE_ARCHIVE")" == "$SUDO_UID" ]] || { echo 'unexpected archive owner' >&2; exit 66; }
  [[ "$(stat -c %u "$SOURCE_CHECKSUM")" == "$SUDO_UID" ]] || { echo 'unexpected checksum owner' >&2; exit 66; }
  [[ "$(stat -c %u "$SOURCE_ATTESTATION")" == "$SUDO_UID" ]] || { echo 'unexpected attestation owner' >&2; exit 66; }
fi

readonly STAGE="$(mktemp -d "$ROOT/.deploy-$RELEASE_SHA.XXXXXX")"
readonly NEXT="$ROOT/.broker-next-$RELEASE_SHA"
cleanup() {
  rm -rf -- "$STAGE"
  rm -f -- "$NEXT" "$SOURCE_ARCHIVE" "$SOURCE_CHECKSUM" "$SOURCE_ATTESTATION"
}
trap cleanup EXIT

install -m 0600 -- "$SOURCE_ARCHIVE" "$STAGE/broker-$RELEASE_SHA.tgz"
install -m 0600 -- "$SOURCE_CHECKSUM" "$STAGE/broker-$RELEASE_SHA.tgz.sha256"
install -m 0600 -- "$SOURCE_ATTESTATION" "$STAGE/broker-$RELEASE_SHA.attestation.jsonl"
cd "$STAGE"
sha256sum --check "broker-$RELEASE_SHA.tgz.sha256"
GH_PAGER=cat NO_COLOR=1 "$GH_CLI" attestation verify "broker-$RELEASE_SHA.tgz" \
  --bundle "broker-$RELEASE_SHA.attestation.jsonl" \
  --custom-trusted-root "$ATTESTATION_TRUST_ROOT" \
  --repo tyj1987/broker \
  --signer-workflow tyj1987/broker/.github/workflows/deploy-ecs.yml \
  --source-ref refs/heads/master \
  --source-digest "$RELEASE_SHA" \
  --deny-self-hosted-runners >/dev/null || {
  echo 'release provenance verification failed' >&2
  exit 66
}

mkdir -p -- "$RELEASES"
readonly RELEASE="$RELEASES/$RELEASE_SHA"
readonly PREVIOUS="$(readlink -f "$CURRENT")"
if [[ -e "$RELEASE" ]]; then
  [[ "$(readlink -f "$RELEASE")" != "$PREVIOUS" ]] || {
    echo 'requested release is already current' >&2
    exit 67
  }
  readonly FAILED_RELEASE="$RELEASES/.failed-$RELEASE_SHA-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mv -- "$RELEASE" "$FAILED_RELEASE"
fi
readonly PAYLOAD="$STAGE/release"
mkdir -- "$PAYLOAD"
tar --extract --gzip --file "$STAGE/broker-$RELEASE_SHA.tgz" --directory "$PAYLOAD" \
  --no-same-owner --no-same-permissions
if find "$PAYLOAD" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit | grep -q .; then
  echo 'release payload contains a forbidden special file or link' >&2
  exit 68
fi
[[ -f "$PAYLOAD/server.js" && -d "$PAYLOAD/node_modules" && -x "$PAYLOAD/bin/secret-broker-policy" && -f "$PAYLOAD/tools/registry.json" && -d "$PAYLOAD/providers" && -n "$(find "$PAYLOAD/providers" -maxdepth 1 -type f -name '*.yaml' -print -quit)" && -f "$PAYLOAD/bin/audit-chain-check.js" && -f "$PAYLOAD/bin/provider-contract-evidence-check.js" && -f "$PAYLOAD/bin/secret-broker-production-preflight.mjs" ]] || { echo 'release payload incomplete' >&2; exit 68; }
"$NODE_RUNTIME" --check "$PAYLOAD/server.js"
"$NODE_RUNTIME" --check "$PAYLOAD/bin/audit-chain-check.js"
"$NODE_RUNTIME" --check "$PAYLOAD/bin/provider-contract-evidence-check.js"
"$NODE_RUNTIME" --check "$PAYLOAD/bin/secret-broker-production-preflight.mjs"
chown -R root:broker "$PAYLOAD"
find "$PAYLOAD" -type d -exec chmod 0550 {} +
find "$PAYLOAD" -type f -exec chmod 0440 {} +
chmod 0550 "$PAYLOAD/bin/secret-broker-policy"
runuser -u broker -- env AUDIT_DIR="$AUDIT_DIR" "$NODE_RUNTIME" "$PAYLOAD/bin/audit-chain-check.js" || {
  echo 'candidate cannot read the current audit chain' >&2
  exit 68
}
mv -- "$PAYLOAD" "$RELEASE"

"$NODE_RUNTIME" "$RELEASE/bin/provider-contract-evidence-check.js" --release "$RELEASE" | grep -Fxq 'provider_contract_evidence_ready=yes' || {
  FAILED_CANDIDATE="$RELEASES/.failed-$RELEASE_SHA-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mv -- "$RELEASE" "$FAILED_CANDIDATE"
  echo 'candidate provider contract evidence is unavailable' >&2
  exit 68
}

ln -s "releases/$RELEASE_SHA" "$NEXT"
mv -T -- "$NEXT" "$CURRENT"
wait_ready() {
  for _ in {1..20}; do
    if curl --fail --silent --show-error --max-time 3 --unix-socket "$HEALTH_SOCKET" http://localhost/ready >/dev/null; then
      return 0
    fi
    sleep 1
  done
  return 1
}
restart_runtime() {
  systemctl restart \
    secret-broker-github-signer.service \
    secret-broker-aliyun-signer.service \
    secret-broker-audit-signer.service \
    secret-broker-audit-store.service \
    secret-broker-audit-recovery.service \
    secret-broker-audit-exporter.service \
    secret-broker-policy.service \
    secret-broker.service
}
full_preflight() {
  "$NODE_RUNTIME" "$CURRENT/bin/secret-broker-production-preflight.mjs" | grep -Fxq 'production_cd_ready=yes'
}
rollback() {
  ln -s "$PREVIOUS" "$NEXT"
  mv -T -- "$NEXT" "$CURRENT"
  restart_runtime && \
    systemctl is-active --quiet secret-broker-policy && \
    systemctl is-active --quiet secret-broker && \
    wait_ready
}
if ! restart_runtime || \
   ! systemctl is-active --quiet secret-broker-policy || \
   ! systemctl is-active --quiet secret-broker; then
  rollback || { echo 'rollback failed readiness verification' >&2; exit 71; }
  exit 69
fi
if ! wait_ready; then
  rollback || { echo 'rollback failed readiness verification' >&2; exit 71; }
  exit 70
fi
if ! full_preflight; then
  rollback || { echo 'rollback failed readiness verification' >&2; exit 71; }
  if ! full_preflight; then
    echo 'rollback restored runtime availability; production acceptance remains closed pending fresh release evidence' >&2
  fi
  exit 72
fi

readonly ARCHIVE_SHA="$(sha256sum "$STAGE/broker-$RELEASE_SHA.tgz" | cut -d' ' -f1)"
printf '%s  %s\n' "$RELEASE_SHA" "$ARCHIVE_SHA" > "$ROOT/deployed-release"
chmod 0644 "$ROOT/deployed-release"
