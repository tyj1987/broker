#!/usr/bin/env bash
set -euo pipefail

[[ "$#" -eq 1 ]] || { echo 'expected exactly one release SHA' >&2; exit 64; }
readonly RELEASE_SHA="${1:-}"
readonly ROOT=/opt/secret-broker
readonly RELEASES="$ROOT/releases"
readonly CURRENT="$ROOT/broker"
readonly SOURCE_ARCHIVE="/tmp/broker-$RELEASE_SHA.tgz"
readonly SOURCE_CHECKSUM="$SOURCE_ARCHIVE.sha256"
readonly NODE_RUNTIME=/opt/secret-broker/runtime/node/bin/node

[[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo 'invalid release SHA' >&2; exit 64; }
[[ -x "$NODE_RUNTIME" ]] || { echo 'pinned Node runtime is unavailable' >&2; exit 65; }
[[ "$($NODE_RUNTIME --version)" =~ ^v24\. ]] || { echo 'pinned Node runtime is outside the supported major version' >&2; exit 65; }
[[ -L "$CURRENT" ]] || { echo 'current release is not a managed symlink' >&2; exit 65; }
[[ "$(systemctl show secret-broker.service -p User --value)" == broker ]] || {
  echo 'broker service is not running as the dedicated user' >&2
  exit 65
}
[[ "$(systemctl show secret-broker.service -p Group --value)" == broker ]] || {
  echo 'broker service is not running as the dedicated group' >&2
  exit 65
}
systemctl is-active --quiet secret-broker-policy.service || {
  echo 'policy core is not active' >&2
  exit 65
}

NGINX_EFFECTIVE="$(nginx -T 2>&1)" || {
  echo 'nginx configuration is invalid' >&2
  exit 65
}
readonly NGINX_EFFECTIVE
grep -Eq '^[[:space:]]*proxy_ssl_verify[[:space:]]+on;' <<<"$NGINX_EFFECTIVE" || {
  echo 'nginx upstream certificate verification is not enabled' >&2
  exit 65
}
if grep -Eq '^[[:space:]]*proxy_ssl_verify[[:space:]]+off;' <<<"$NGINX_EFFECTIVE"; then
  echo 'nginx contains disabled upstream certificate verification' >&2
  exit 65
fi

for forbidden_key_root in \
  /etc/secret-broker/pki/ca \
  /etc/secret-broker/pki/clients \
  /opt/secret-broker/pki; do
  if [[ -d "$forbidden_key_root" ]] && \
    find "$forbidden_key_root" -type f -name '*.key' -print -quit | grep -q .; then
    echo "forbidden CA or client private key exists under $forbidden_key_root" >&2
    exit 65
  fi
done
[[ -f "$SOURCE_ARCHIVE" && ! -L "$SOURCE_ARCHIVE" ]] || { echo 'release archive missing or unsafe' >&2; exit 66; }
[[ -f "$SOURCE_CHECKSUM" && ! -L "$SOURCE_CHECKSUM" ]] || { echo 'release checksum missing or unsafe' >&2; exit 66; }

if [[ -n "${SUDO_UID:-}" ]]; then
  [[ "$(stat -c %u "$SOURCE_ARCHIVE")" == "$SUDO_UID" ]] || { echo 'unexpected archive owner' >&2; exit 66; }
  [[ "$(stat -c %u "$SOURCE_CHECKSUM")" == "$SUDO_UID" ]] || { echo 'unexpected checksum owner' >&2; exit 66; }
fi

readonly STAGE="$(mktemp -d "$ROOT/.deploy-$RELEASE_SHA.XXXXXX")"
readonly NEXT="$ROOT/.broker-next-$RELEASE_SHA"
cleanup() {
  rm -rf -- "$STAGE"
  rm -f -- "$NEXT" "$SOURCE_ARCHIVE" "$SOURCE_CHECKSUM"
}
trap cleanup EXIT

install -m 0600 -- "$SOURCE_ARCHIVE" "$STAGE/broker-$RELEASE_SHA.tgz"
install -m 0600 -- "$SOURCE_CHECKSUM" "$STAGE/broker-$RELEASE_SHA.tgz.sha256"
cd "$STAGE"
sha256sum --check "broker-$RELEASE_SHA.tgz.sha256"

mkdir -p -- "$RELEASES"
readonly RELEASE="$RELEASES/$RELEASE_SHA"
[[ ! -e "$RELEASE" ]] || { echo 'release already exists' >&2; exit 67; }
mkdir -- "$RELEASE"
tar --extract --gzip --file "$STAGE/broker-$RELEASE_SHA.tgz" --directory "$RELEASE" \
  --no-same-owner --no-same-permissions
if find "$RELEASE" \( -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit | grep -q .; then
  echo 'release payload contains a forbidden special file or link' >&2
  exit 68
fi
[[ -f "$RELEASE/server.js" && -d "$RELEASE/node_modules" && -x "$RELEASE/bin/secret-broker-policy" ]] || { echo 'release payload incomplete' >&2; exit 68; }
"$NODE_RUNTIME" --check "$RELEASE/server.js"
chown -R root:broker "$RELEASE"
find "$RELEASE" -type d -exec chmod 0550 {} +
find "$RELEASE" -type f -exec chmod 0440 {} +
chmod 0550 "$RELEASE/bin/secret-broker-policy"

readonly PREVIOUS="$(readlink -f "$CURRENT")"
ln -s "releases/$RELEASE_SHA" "$NEXT"
mv -T -- "$NEXT" "$CURRENT"
rollback() {
  ln -s "$PREVIOUS" "$NEXT"
  mv -T -- "$NEXT" "$CURRENT"
  systemctl restart secret-broker-policy secret-broker
}
if ! systemctl restart secret-broker-policy secret-broker || \
   ! systemctl is-active --quiet secret-broker-policy || \
   ! systemctl is-active --quiet secret-broker; then
  rollback
  exit 69
fi
healthy=false
for _ in {1..20}; do
  if curl --fail --silent --show-error --max-time 3 http://127.0.0.1:9080/health >/dev/null; then
    healthy=true
    break
  fi
  sleep 1
done
if [[ "$healthy" != true ]]; then
  rollback
  exit 70
fi

readonly ARCHIVE_SHA="$(sha256sum "$STAGE/broker-$RELEASE_SHA.tgz" | cut -d' ' -f1)"
printf '%s  %s\n' "$RELEASE_SHA" "$ARCHIVE_SHA" > "$ROOT/deployed-release"
chmod 0644 "$ROOT/deployed-release"
