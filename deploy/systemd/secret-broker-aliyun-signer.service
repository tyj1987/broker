[Unit]
Description=Secret Broker isolated Alibaba Cloud signing workload
Requires=secret-broker-aliyun-signer.socket
After=network-online.target secret-broker-aliyun-signer.socket
Wants=network-online.target

[Service]
Type=simple
User=broker-aliyun-signer
Group=broker-aliyun-signer
ExecStart=/opt/secret-broker/broker/bin/secret-broker-aliyun-signer --config /etc/secret-broker/providers/aliyun-signer.json
Restart=on-failure
RestartSec=5s
UMask=0007
LimitCORE=0
IPAddressDeny=any
IPAddressAllow=100.100.100.200/32

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
