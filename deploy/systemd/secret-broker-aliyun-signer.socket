[Unit]
Description=Secret Broker root-owned Alibaba Cloud signer socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/secret-broker-aliyun-signer/signer.sock
Accept=no
SocketUser=root
SocketGroup=broker-aliyun-signer
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true
Service=secret-broker-aliyun-signer.service

[Install]
WantedBy=sockets.target
