[Unit]
Description=Secret Broker isolated Tencent immutable audit mirror worker
Requires=secret-broker-audit-mirror-worker.socket
After=network-online.target secret-broker-audit-mirror-worker.socket
Wants=network-online.target

[Service]
Type=simple
User=broker-audit-mirror
Group=broker-audit-mirror
ExecStart=/opt/secret-broker/broker/bin/secret-broker-audit-mirror-worker --config /etc/secret-broker/audit/mirror-worker.json
UMask=0027
LimitCORE=0

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any
