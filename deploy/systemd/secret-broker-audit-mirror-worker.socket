[Unit]
Description=Secret Broker root-owned audit mirror worker socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/secret-broker-audit-mirror/mirror.sock
FileDescriptorName=audit-mirror
Accept=no
SocketUser=root
SocketGroup=broker-audit-store
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true
Service=secret-broker-audit-mirror-worker.service
