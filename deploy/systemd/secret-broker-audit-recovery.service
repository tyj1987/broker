[Unit]
Description=Secret Broker independent audit recovery verifier
After=secret-broker-audit-store.service
Requires=secret-broker-audit-store.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=75s
TimeoutStopSec=5s
WatchdogSec=120s
KillMode=control-group
User=broker-audit-recovery
Group=broker-audit-recovery
SupplementaryGroups=broker-audit-store
ExecStart=/opt/secret-broker/broker/bin/secret-broker-audit-recovery --config /etc/secret-broker/audit/recovery.json
Restart=on-failure
RestartSec=5s
UMask=0027
RuntimeDirectory=secret-broker-audit-recovery
RuntimeDirectoryMode=0750

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateNetwork=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
