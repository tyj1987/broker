[Unit]
Description=Secret Broker independent audit anchor signer
Requires=secret-broker-audit-signer.socket
After=network-online.target secret-broker-audit-signer.socket
Wants=network-online.target

[Service]
Type=simple
User=broker-audit-signer
Group=broker-audit-signer
ExecStart=/opt/secret-broker/broker/bin/secret-broker-audit-signer --config /etc/secret-broker/audit/signer.json
Restart=on-failure
RestartSec=5s
UMask=0007
LimitCORE=0

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
IPAddressDeny=any
IPAddressAllow=100.100.100.200/32
IPAddressAllow=100.100.2.136/32
IPAddressAllow=100.100.2.138/32

[Install]
WantedBy=multi-user.target
