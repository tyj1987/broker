[Unit]
Description=Secret Broker root-owned audit anchor signer socket
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/secret-broker-audit-anchor/signer.sock
FileDescriptorName=audit-signer
Accept=no
SocketUser=root
SocketGroup=broker-audit-signer
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true
Service=secret-broker-audit-signer.service

[Install]
WantedBy=sockets.target
