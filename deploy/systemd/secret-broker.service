[Unit]
Description=Secret Broker
After=network-online.target secret-broker-policy.service
Wants=network-online.target
Requires=secret-broker-policy.service

[Service]
Type=simple
User=broker
Group=broker
WorkingDirectory=/opt/secret-broker/broker
ExecStart=/opt/secret-broker/runtime/node/bin/node /opt/secret-broker/broker/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

Environment=NODE_ENV=production
Environment=PORT=8443
Environment=BROKER_BIND=127.0.0.1
Environment=BROKER_HEALTH_SOCKET=/run/secret-broker-health/health.sock
Environment=CONFIG_PATH=/var/lib/secret-broker/secrets/broker.yaml
Environment=SECRETS_PATH=/var/lib/secret-broker/secrets/common.env
Environment=SECRETS_DETAIL_PATH=/var/lib/secret-broker/secrets/secrets-detail.json
Environment=AGE_KEY_FILE=/etc/secret-broker/age/age.key
Environment=PKI_DIR=/etc/secret-broker/pki
Environment=TLS_CERT=/etc/secret-broker/pki/server/server.crt
Environment=TLS_KEY=/etc/secret-broker/pki/server/server.key
Environment=TLS_CA=/etc/secret-broker/pki/ca/ca.crt
Environment=AUDIT_DIR=/var/lib/secret-broker/audit
Environment=BROKER_CORE_SOCKET=/run/secret-broker/core.sock
Environment=CONTROL_PLANE_STATE_PATH=/var/lib/secret-broker/control-plane-state.enc
Environment=CONTROL_PLANE_STATE_KEY_FILE=%d/control-plane-state.key
LoadCredential=control-plane-state.key:/etc/secret-broker/control-plane-state.key

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
StateDirectory=secret-broker
StateDirectoryMode=0700
RuntimeDirectory=secret-broker-health
RuntimeDirectoryMode=0700
ReadWritePaths=/var/lib/secret-broker

[Install]
WantedBy=multi-user.target
