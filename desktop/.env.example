# Tauri desktop — build-time environment variables (EXAMPLE — copy to .env)
#
# This file is gitignored. To configure the Tauri build, copy this to
# `.env` and fill in your real values. These vars are read by the Tauri
# config (tauri.conf.json) at build time via ${VAR} substitution.
#
# All values are required for Phase 5 (auto-update + code signing).
# Phase 1-4 (dev + V0.1.0 alpha) can leave these blank — the build
# will work but auto-update and signed-install won't.

# --- Auto-update (Tauri updater) ---
# ed25519 public key (base64) corresponding to ~/.tauri/updater.key.
# Generate with: `tauri signer generate -w ~/.tauri/updater.key`
# Commit the .pub file to repo at desktop/.tauri/updater.pub (do NOT
# commit the .key file). The .pub contents goes here as base64.
TAURI_UPDATER_PUBKEY=

# --- Windows code signing ---
# SHA-1 thumbprint of your EV code signing certificate. Get with:
#   certutil -store My "Code Signing" | findstr /i "Cert Hash"
# Leave blank for Phase 1-4 (unsigned build, shows SmartScreen warning).
WINDOWS_CERTIFICATE_THUMBPRINT=

# DigiCert timestamp URL (used during sign). Override only if using
# a different CA (e.g. Sectigo). Default is DigiCert.
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com

# --- macOS code signing ---
# Apple Developer ID identity (e.g. "Developer ID Application: Tyj (TEAMID)")
# Get with: `security find-identity -v -p codesigning`
# Leave blank for Phase 1-4.
MACOS_SIGNING_IDENTITY=

# Apple notarization team ID (10-char alphanumeric). Required for
# notarizing .dmg/.app for distribution outside App Store.
# Get from: https://developer.apple.com/account/#/membership
MACOS_TEAM_ID=

# --- AppImage / deb / rpm signing (Linux) ---
# GPG key fingerprint (40 hex chars) for signing .deb and .rpm.
# Generate with: gpg --full-gen-key (RSA 4096-bit, name + email)
# Get fingerprint with: gpg --list-secret-keys --keyid-format LONG
LINUX_GPG_FINGERPRINT=

# --- Local dev (optional, useful for testing multi-broker setup) ---
# Comma-separated list of broker endpoints the desktop client can switch
# between. First entry is default. Format: "Name|https://host:port"
BROKER_ENDPOINTS="Local|https://localhost:8443,Remote|https://broker.52trz.com:8443"

# --- Tauri build flags (advanced) ---
# Set to "1" to enable updater artifact generation (slower build)
# Leave blank for dev builds.
TAURI_BUILD_UPDATER=

# --- Usage ---
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in the values for your release target
# 3. For Phase 1-4 (dev / V0.1.0 alpha): leave auto-update vars blank
# 4. For Phase 5 (V1.0.0 GA with auto-update): fill in TAURI_UPDATER_PUBKEY
# 5. For signed Windows builds: fill in WINDOWS_CERTIFICATE_THUMBPRINT
# 6. For notarized macOS builds: fill in MACOS_SIGNING_IDENTITY + MACOS_TEAM_ID
# 7. For signed Linux packages: fill in LINUX_GPG_FINGERPRINT
# 8. Build: npx tauri build (reads .env automatically via dotenv)
