# b.tfvars.example
# 阿里云 broker 部署变量 / Aliyun broker deployment variables
#
# Usage:
#   1. 复制这个文件到 b.tfvars: cp b.tfvars.example b.tfvars
#   2. 填好下面的值
#   3. terraform plan -var-file=b.tfvars
#   4. terraform apply -var-file=b.tfvars
#
# b.tfvars contains deployment identifiers only; never put passwords or private keys here.

# 阿里云 region
region = "cn-beijing"

# SSH 入口白名单 - 你的办公 IP
# 怎么查：curl https://ifconfig.me
admin_cidr = "1.2.3.4/32"   # ← 改成你办公出口 IP

# Existing Aliyun SSH key-pair name. The private key stays out-of-band.
ssh_key_name = "secret-broker-admin"

# broker 域名（用户本机解析到 EIP 即可）
# 用你自己的域名；DNS 解析你自己搞定
broker_domain = "broker.52trz.com"

# 额外 SAN（mTLS 证书也认这些）
broker_alt_names = ["localhost", "127.0.0.1"]
