# b.tfvars.example
# 阿里云 broker 部署变量 / Aliyun broker deployment variables
#
# Usage:
#   1. 复制这个文件到 b.tfvars: cp b.tfvars.example b.tfvars
#   2. 填好下面的值
#   3. terraform plan -var-file=b.tfvars
#   4. terraform apply -var-file=b.tfvars
#
# This file contains identifiers only. Authentication uses an OIDC-backed role.

# 阿里云 region
region = "cn-beijing"

# SSH 入口白名单 - 你的办公 IP
# 怎么查：curl https://ifconfig.me
admin_cidr = "203.0.113.5/32"

# Existing ECS SSH key pair; private key material never enters Terraform.
ssh_key_name = "secret-broker-deploy"
operation_role_arns = [
  "acs:ram::1234567890123456:role/secret-broker-readonly"
]

# Resolve these from the selected VPC/region documentation and review them
# before applying. Placeholder ranges deliberately fail real connectivity.
dns_resolver_cidrs = ["192.0.2.53/32"]
ntp_server_cidrs   = ["192.0.2.123/32"]

# broker 域名（用户本机解析到 EIP 即可）
# 用你自己的域名；DNS 解析你自己搞定
broker_domain = "broker.example.com"

# 额外 SAN（mTLS 证书也认这些）
broker_alt_names = ["localhost", "127.0.0.1"]
