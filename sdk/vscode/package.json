{
  "name": "secret-broker",
  "displayName": "Secret Broker",
  "description": "AI-first mTLS secret broker for VS Code / Cursor",
  "version": "4.2.0",
  "publisher": "tyj1987",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["secret-broker", "credentials", "ai", "mtls", "security"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyj1987/broker.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:secretBroker.health",
    "onCommand:secretBroker.list",
    "onCommand:secretBroker.operation.create"
  ],
  "contributes": {
    "commands": [
      {
        "command": "secretBroker.health",
        "title": "Secret Broker: Health Check",
        "category": "Secret Broker"
      },
      {
        "command": "secretBroker.list",
        "title": "Secret Broker: List Secrets",
        "category": "Secret Broker"
      },
      {
        "command": "secretBroker.operation.create",
        "title": "Secret Broker: Create Typed Operation",
        "category": "Secret Broker"
      }
    ],
    "configuration": {
      "title": "Secret Broker",
      "properties": {
        "secretBroker.endpoint": {
          "type": "string",
          "default": "https://127.0.0.1:8443",
          "description": "Broker endpoint URL"
        },
        "secretBroker.clientCert": {
          "type": "string",
          "default": "",
          "description": "Path to mTLS client cert (PEM)"
        },
        "secretBroker.clientKey": {
          "type": "string",
          "default": "",
          "description": "Path to mTLS client key (PEM)"
        },
        "secretBroker.caCert": {
          "type": "string",
          "default": "",
          "description": "Path to broker CA cert (PEM)"
        },
        "secretBroker.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show broker health in status bar"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package",
    "test": "node --test ./out/test/client.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
