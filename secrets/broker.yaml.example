# broker.yaml.example
# Secret Broker 服务端配置
# SOPS 加密后放到 secrets/broker.yaml
# 加密命令: sops --encrypt --in-place secrets/broker.yaml
#
# 字段说明:
#   services: 代理模式可用的外部服务
#   clients:  客户端证书 -> 权限映射

# ==========================================================
# Services：broker 可以代理的外部服务
# ==========================================================
services:

  # GitHub - Personal Access Token
  # AI 调 GitHub 时 broker 自动注入 PAT
  github:
    type: github_token            # type: bearer | github_token | header | aliyun_v2 | tencent_v3
    token_secret: github.pat      # 从 common.env 解析的密钥名
    upstream: https://api.github.com
    allow_methods: [GET, POST, PATCH, DELETE, PUT]
    inject_headers:
      Accept: application/vnd.github+json
      X-GitHub-Api-Version: "2022-11-28"

  # 阿里云 ECS OpenAPI
  aliyun_ecs:
    type: aliyun_v2
    access_key_secret: aliyun.access_key
    access_secret_secret: aliyun.access_secret
    region: cn-hangzhou
    upstream: https://ecs.aliyuncs.com
    allow_products: [ECS, VPC, SLB]   # 限制只能调 ECS/VPC/SLB

  # 腾讯云 CVM OpenAPI
  tencent_cvm:
    type: tencent_v3
    access_key_secret: tencent.secret_id
    access_secret_secret: tencent.secret_key
    region: ap-shanghai
    upstream: https://cvm.tencentcloudapi.com
    allow_products: [CVM, VPC]

  # OpenAI
  openai:
    type: header
    header_name: Authorization
    header_value_template: "Bearer {{secret}}"
    token_secret: openai.api_key
    upstream: https://api.openai.com

  # Anthropic
  anthropic:
    type: header
    header_name: x-api-key
    header_value_template: "{{secret}}"
    token_secret: anthropic.api_key
    upstream: https://api.anthropic.com
    inject_headers:
      anthropic-version: "2023-06-01"

  # 通用 Bearer Token
  generic_api:
    type: bearer
    token_secret: some.api_key
    upstream: https://api.example.com

# ==========================================================
# Clients：每个客户端证书的权限
# CN 必须在 pki/clients/ 下有对应证书
# cert_fingerprint_sha256: 签发时脚本会自动写入
# ==========================================================
clients:

  # 你的主力笔记本
  "client.tyj-laptop":
    cert_fingerprint_sha256: "AB:CD:EF:Gh:..."   # 填 issue-client-cert.ps1 输出
    role: developer
    allowed_resolve: []              # 不允许拉明文
    allowed_proxy:
      - service: github
        paths: ["^/(user|repos|gists|orgs)/.*"]
        methods: [GET, POST, PATCH]
      - service: aliyun_ecs
        products: [ECS]
    rate_limit: "200/hour"

  # 家里台式机
  "client.tyj-desktop":
    cert_fingerprint_sha256: "..."
    role: developer
    allowed_resolve:
      - "^github\\.pat$"             # 只允许拉 github.pat 这一个
    allowed_proxy:
      - service: github
        paths: ["^/(user|repos)/.*"]
    rate_limit: "100/hour"

  # CI runner - 自动化任务用，权限窄
  "client.ci-runner":
    cert_fingerprint_sha256: "..."
    role: ci
    allowed_resolve:
      - "^github\\.deploy_key$"
    allowed_proxy:
      - service: github
        paths: ["^/repos/[^/]+/[^/]+/deployments$"]
        methods: [POST]
    rate_limit: "1000/hour"

  # Admin（管理 dashboard 用）—— 谨慎签发
  "client.dashboard-admin":
    cert_fingerprint_sha256: "..."
    role: admin                       # admin 可以 resolve/proxy 所有
    allowed_resolve: [".*"]
    allowed_proxy: [".*"]
    rate_limit: "unlimited"
