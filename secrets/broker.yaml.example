# broker.yaml.example
# Secret Broker 服务端配置
# SOPS 加密后放到 secrets/broker.yaml
# 加密命令: sops --encrypt --in-place secrets/broker.yaml
#
# 字段说明:
#   services: 代理模式可用的外部服务
#   clients:  客户端证书 -> 权限映射

# ==========================================================
# Services：broker 可以代理的外部服务
# ==========================================================
services:

  # GitHub - Personal Access Token
  # AI 调 GitHub 时 broker 自动注入 PAT
  github:
    type: github_token            # type: bearer | github_token | header | aliyun_v2 | tencent_v3
    token_secret: github.pat      # 从 common.env 解析的密钥名
    upstream: https://api.github.com
    allow_methods: [GET, POST, PATCH, DELETE, PUT]
    inject_headers:
      Accept: application/vnd.github+json
      X-GitHub-Api-Version: "2022-11-28"
    # ---- 以下字段仅供 Dashboard「AI Actions」视图展示，不含任何密钥 ----
    description: "GitHub API · PAT 自动注入"
    dashboard_actions:
      - label: 查看我的信息
        method: GET
        path: /user
      - label: 查看仓库详情
        method: GET
        path: /repos/tyj1987/sops-age-template
      - label: 列出我的仓库
        method: GET
        path: /user/repos
        query: { per_page: "5" }

  # 阿里云 ECS OpenAPI
  aliyun_ecs:
    type: aliyun_v2
    access_key_secret: aliyun.access_key
    access_secret_secret: aliyun.access_secret
    region: cn-hangzhou
    upstream: https://ecs.aliyuncs.com
    allow_products: [ECS, VPC, SLB]   # 限制只能调 ECS/VPC/SLB
    # Dashboard 快速动作（Action 放在 query 里，服务端自动签名）
    description: "阿里云 ECS OpenAPI · 签名自动注入"
    dashboard_actions:
      - label: 查询可用区域
        method: GET
        path: /
        query: { Action: "DescribeRegions" }
      - label: 列出实例
        method: GET
        path: /
        query: { Action: "DescribeInstances", RegionId: "cn-hangzhou" }

  # 腾讯云 CVM OpenAPI
  tencent_cvm:
    type: tencent_v3
    access_key_secret: tencent.secret_id
    access_secret_secret: tencent.secret_key
    region: ap-shanghai
    upstream: https://cvm.tencentcloudapi.com
    allow_products: [CVM, VPC]

  # OpenAI
  openai:
    type: header
    header_name: Authorization
    header_value_template: "Bearer {{secret}}"
    token_secret: openai.api_key
    upstream: https://api.openai.com
    description: "OpenAI API · Bearer Key 自动注入"
    dashboard_actions:
      - label: 模型列表
        method: GET
        path: /v1/models
      - label: 发起对话
        method: POST
        path: /v1/chat/completions
        body:
          model: "gpt-4o-mini"
          messages: [{ role: "user", content: "Hi, reply in one sentence." }]

  # Anthropic
  anthropic:
    type: header
    header_name: x-api-key
    header_value_template: "{{secret}}"
    token_secret: anthropic.api_key
    upstream: https://api.anthropic.com
    inject_headers:
      anthropic-version: "2023-06-01"

  # 通用 Bearer Token
  generic_api:
    type: bearer
    token_secret: some.api_key
    upstream: https://api.example.com

  # Cloudflare API (M3.5, 2026-08-15)
  # 用于: 改 DNS records + 改 Cloudflare Tunnel ingress + Zone 设置
  # API token scope 推荐: Zone:DNS:Edit + Account:Cloudflare Tunnel:Edit (Zone 资源)
  # account_id 字段从 secret.fields.account_id 取, 不在 yaml 里硬编码
  cloudflare:
    type: bearer
    token_secret: cloudflare
    token_field: api_token                    # cloudflare_token type secret 的 api_token 字段
    upstream: https://api.cloudflare.com/client/v4
    allow_methods: [GET, POST, PUT, PATCH, DELETE]
    # allowed_paths: scope 限死, 防止 agent 改任意 zone/setting
    allow_paths:
      - "^/user$"                            # 验证 token + 看账户信息
      - "^/zones(/.*)?$"                     # list zones, get zone details, list/edit DNS records
      - "^/zones/[^/]+/dns_records(/.*)?$"   # CRUD DNS records under any zone
      - "^/accounts/[^/]+/tunnels(/.*)?$"    # list/inspect tunnels
      - "^/accounts/[^/]+/tunnels/[^/]+/configurations$"  # PUT tunnel config (改 ingress)
    inject_headers:
      Content-Type: application/json
    description: "Cloudflare API · Token 自动注入 (改 DNS + Tunnel ingress)"
    dashboard_actions:
      - label: 验证 Token 有效性
        method: GET
        path: /user
      - label: 列出所有 Zones
        method: GET
        path: /zones
        query: { per_page: "50" }

# ==========================================================
# Clients：每个客户端证书的权限
# CN 必须在 pki/clients/ 下有对应证书
# cert_fingerprint_sha256: 签发时脚本会自动写入
# ==========================================================
clients:

  # 你的主力笔记本
  "client.tyj-laptop":
    cert_fingerprint_sha256: "AB:CD:EF:Gh:..."   # 填 issue-client-cert.ps1 输出
    role: developer
    allowed_resolve: []              # 不允许拉明文
    allowed_proxy:
      - service: github
        paths: ["^/(user|repos|gists|orgs)/.*"]
        methods: [GET, POST, PATCH]
      - service: aliyun_ecs
        products: [ECS]
    rate_limit: "200/hour"

  # 家里台式机
  "client.tyj-desktop":
    cert_fingerprint_sha256: "..."
    role: developer
    allowed_resolve:
      - "^github\\.pat$"             # 只允许拉 github.pat 这一个
    allowed_proxy:
      - service: github
        paths: ["^/(user|repos)/.*"]
    rate_limit: "100/hour"

  # CI runner - 自动化任务用，权限窄
  "client.ci-runner":
    cert_fingerprint_sha256: "..."
    role: ci
    allowed_resolve:
      - "^github\\.deploy_key$"
    allowed_proxy:
      - service: github
        paths: ["^/repos/[^/]+/[^/]+/deployments$"]
        methods: [POST]
    rate_limit: "1000/hour"

  # Admin（管理 dashboard 用）—— 谨慎签发
  "client.dashboard-admin":
    cert_fingerprint_sha256: "..."
    role: admin                       # admin 可以 resolve/proxy 所有
    allowed_resolve: [".*"]
    allowed_proxy: [".*"]
    rate_limit: "unlimited"
    password: "generate-a-strong-one" # Dashboard 登录密码（mTLS 或密码方式登录都需要）
    allow_password_login: true        # 允许浏览器「仅密码」登录（无需客户端证书）——
                                      # 便于把「网页 + 密码」直接交给 AI 使用；
                                      # 暴力破解由 broker 锁定（5 次失败锁 15 分钟）。
                                      # 默认关：不开此字段时，登录必须带客户端证书（mTLS）。
