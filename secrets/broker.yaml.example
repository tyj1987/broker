# Secret Broker strict-profile example
#
# Copy this file to an operator-controlled location, replace every placeholder,
# then encrypt it with the approved KMS/SOPS workflow. Do not commit the result.
# This example intentionally contains no passwords, API keys, AccessKeys,
# private keys, recovery codes, webhook URLs, or plaintext secret references.

services: {}
api_keys: {}
device_registry: []

clients:
  client.owner:
    # Replace with the SHA-256 fingerprint from an independently verified
    # certificate enrollment. A copied certificate alone is not authentication.
    cert_fingerprint_sha256: "REPLACE_WITH_VERIFIED_SHA256_FINGERPRINT"
    role: admin
    security_profile: strict
    allow_password_login: false
    allowed_resolve: []
    allowed_proxy: []
    allowed_services: [aliyun, broker]
    rate_limit: 100/hour

    # Production startup must fail until two non-synced, hardware-bound FIDO2
    # credentials have been registered. Non-production may explicitly enable
    # the one-time bootstrap mode; never enable it in production.
    webauthn_bootstrap: true
    factors:
      webauthn:
        credentials: []

operation_policies:
  broker:
    tools.inspect:
      enabled: true
      execution_mode: adapter
      contract_verified: true
      roles: [admin]
      security_profiles: [strict]
      identity_methods: [mtls, session]
      environments: [production]
      accounts: [control-plane]
      resources: [tool-registry]
      approval_required: false
      ttl_seconds: 60
      secret_refs: []
      parameter_schema:
        type: object
        required: [resource_ref, tool_name, tool_version]
        properties:
          resource_ref: { type: string, enum: [tool-registry] }
          tool_name: { type: string, format: identifier, max_length: 128 }
          tool_version: { type: string, max_length: 32 }
    device.enroll:
      enabled: true
      execution_mode: adapter
      contract_verified: true
      roles: [admin]
      security_profiles: [strict]
      identity_methods: [session]
      environments: [production]
      accounts: [control-plane]
      resources: [device-registration]
      approval_required: true
      required_approvals: 2
      approval_roles: [admin]
      ttl_seconds: 60
      secret_refs: []
      parameter_schema:
        type: object
        required: [resource_ref, label, platform, capabilities]
        properties:
          resource_ref: { type: string, format: identifier }
          label: { type: string, format: identifier, max_length: 80 }
          platform: { type: string, enum: [android, windows, linux, ios, browser-worker] }
          capabilities: { type: array, max_items: 32, items: { type: string, format: identifier, max_length: 64 } }
    device.state:
      enabled: true
      execution_mode: adapter
      contract_verified: true
      roles: [admin]
      security_profiles: [strict]
      identity_methods: [session]
      environments: [production]
      accounts: [control-plane]
      resources: [device-state]
      approval_required: true
      required_approvals: 2
      approval_roles: [admin]
      ttl_seconds: 60
      secret_refs: []
      parameter_schema:
        type: object
        required: [resource_ref, device_id, state]
        properties:
          resource_ref: { type: string, format: identifier }
          device_id: { type: string, format: identifier, max_length: 128 }
          state: { type: string, enum: [active, suspended, revoked] }
    emergency.stop:
      enabled: true
      execution_mode: adapter
      contract_verified: true
      roles: [admin]
      security_profiles: [strict]
      identity_methods: [session]
      environments: [production]
      accounts: [control-plane]
      resources: [control-plane]
      approval_required: true
      required_approvals: 2
      approval_roles: [admin]
      ttl_seconds: 60
      secret_refs: []
      parameter_schema:
        type: object
        required: [resource_ref, engaged, reason_code]
        properties:
          resource_ref: { type: string, enum: [control-plane] }
          engaged: { type: boolean }
          reason_code: { type: string, format: identifier, max_length: 128 }
  aliyun:
    ecs.instances.list:
      enabled: true
      execution_mode: adapter
      # Set true only after the isolated-account provider contract evidence is
      # reviewed for this exact operation and provider manifest revision.
      contract_verified: false
      roles: [admin]
      security_profiles: [strict]
      identity_methods: [mtls, session]
      environments: [production]
      accounts: [primary]
      resources: [ecs-inventory]
      approval_required: false
      ttl_seconds: 60
      # Optional request conditions are evaluated in both the Node transition
      # layer and the Go policy core. An invalid value denies the operation.
      # source_cidrs: [203.0.113.0/24, 2001:db8::/32]
      # not_before: '2026-09-09T00:00:00Z'
      # not_after: '2026-09-10T00:00:00Z'
      secret_refs: []
      parameter_schema:
        type: object
        required: [resource_ref, region_id]
        properties:
          resource_ref:
            type: string
            format: identifier
            max_length: 128
          region_id:
            type: string
            format: identifier
            max_length: 64
          page_number:
            type: integer
          page_size:
            type: integer

# Workloads should use a short-lived OIDC subject to assume an explicit
# operation role. Role identifiers are configuration metadata, not credentials.
workload_identity:
  providers:
    aliyun:
      type: oidc
      oidc_provider_arn: "acs:ram::REPLACE_ACCOUNT_ID:oidc-provider/secret-broker"
      role_arns:
        - "acs:ram::REPLACE_ACCOUNT_ID:role/secret-broker-ecs-readonly"
      audience: "secret-broker-production"

alerting:
  channels: []
