# Common secrets (used in dev + prod)
# 通用配置（开发 + 生产都用）
DATABASE_URL=postgres://user:password@localhost:5432/myapp
REDIS_URL=redis://localhost:6379

# JWT secret (replace with strong random in production)
# JWT 密钥（生产环境务必替换为强随机值）
JWT_SECRET=change-me-to-strong-random-value

# Third-party API examples (uncomment and fill in)
# 第三方 API 示例（取消注释并填值）
# OPENAI_API_KEY=sk-xxx
# STRIPE_SECRET_KEY=sk_test_xxx